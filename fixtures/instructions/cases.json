    {
      "case_id": "instr_007_ambiguous_instruction",
      "input": {
        "instructions": [
          "Make the code as good as you can."
        ],
        "before": {
          "src/app.py": "x = 1\n"
        },
        "after": {
          "src/app.py": "x = 2\n"
        }
      },
      "expected": {
        "inconclusive_instructions": 1,
        "verdict": "inconclusive"
      },
      "label_origin": "model_drafted",
      "split": "dev",
      "rationale": "An instruction that cannot be turned into a predicate must be reported as inconclusive, never as a pass. Claiming compliance here would be a false assurance.",
      "tags": [
        "ambiguous",
        "abstain",
        "false_accusation_control"
      ]
    },
    {
      "case_id": "instr_008_mixed_instructions",
      "input": {
        "instructions": [
          "Do not modify config/settings.toml",
          "Add a test for tests/test_app.py",
          "Keep the output format REPORT_JSON"
        ],
        "before": {
          "config/settings.toml": "debug = false\n"
        },
        "after": {
          "config/settings.toml": "debug = false\n",
          "tests/test_app.py": "def test_app():\n    assert True\n",
          "out/report.json": "{\"REPORT_JSON\": true}\n"
        }
      },
      "expected": {
        "violated": 0,
        "passed": 3,
        "verdict": "passed"
      },
      "label_origin": "model_drafted",
      "split": "dev",
      "rationale": "Three predicates, all satisfied. A checker that handles only one kind of instruction would fail this.",
      "tags": [
        "multi_predicate",
        "happy_path"
      ]
    },
    {
      "case_id": "instr_009_one_of_three_violated",
      "input": {
        "instructions": [
          "Do not modify config/settings.toml",
          "Add a test for tests/test_app.py",
          "Keep the output format REPORT_JSON"
        ],
        "before": {
          "config/settings.toml": "debug = false\n"
        },
        "after": {
          "config/settings.toml": "debug = true\n",
          "tests/test_app.py": "def test_app():\n    assert True\n",
          "out/report.json": "{\"other\": true}\n"
        }
      },
      "expected": {
        "violated": 2,
        "verdict": "violated"
      },
      "label_origin": "model_drafted",
      "split": "dev",
      "rationale": "Two of the three predicates fail. The count must be exact, not \"at least one\".",
      "tags": [
        "multi_predicate",
        "violation"
      ]
    }
  ]
