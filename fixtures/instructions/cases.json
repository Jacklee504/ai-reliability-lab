  "cases": [
    {
      "case_id": "instr_001_unchanged_file_respected",
      "input": {
        "instructions": [
          "Do not modify config/settings.toml"
        ],
        "before": {
          "config/settings.toml": "debug = false\n"
        },
        "after": {
          "config/settings.toml": "debug = false\n",
          "src/app.py": "print(1)\n"
        }
      },
      "expected": {
        "violated": 0,
        "passed": 1,
        "verdict": "passed"
      },
      "label_origin": "model_drafted",
      "split": "dev",
      "rationale": "The protected file was not modified. The control case: a checker that reports every violation is useless.",
      "tags": [
        "control",
        "happy_path"
      ]
    },
    {
