{
  "cases": [
    {
      "case_id": "instr_t07_mixed_one_violated",
      "input": {
        "instructions": [
          "Do not modify config/prod.toml",
          "Add a test for tests/test_new.py",
          "Run the linter"
        ],
        "before": {
          "config/prod.toml": "retries = 3\n"
        },
        "after": {
          "config/prod.toml": "retries = 9\n",
          "tests/test_new.py": "def test_new():\n    assert True\n"
        },
        "trace": [
          "ruff check ."
        ]
      },
      "expected": {
        "violated": 1,
        "must_violate_containing": [
          "prod.toml"
        ],
        "verdict": "violated"
      },
      "label_origin": "model_drafted",
      "split": "test",
      "rationale": "Exactly one of the three predicates fails. The count must be exact.",
      "tags": [
        "multi_predicate",
        "violation"
      ]
    },
