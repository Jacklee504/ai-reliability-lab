    {
      "case_id": "instr_005_command_run",
      "input": {
        "instructions": [
          "Run the linter before finishing."
        ],
        "before": {
          "src/app.py": "x = 1\n"
        },
        "after": {
          "src/app.py": "x = 1\n"
        },
        "trace": [
